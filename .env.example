# Copy to .env.local for `vercel dev`. Never commit real values.
# In production these are set in the Vercel dashboard:
#   Settings -> Environment Variables (tick Production, Preview, Development)

# ---- Meta tracking (required) ----
META_PIXEL_ID=823926397477218
META_CAPI_TOKEN=

# Set ONLY while testing in Events Manager -> Test Events.
# Delete it before going live: events carrying a test code do not
# count toward ad optimisation.
META_TEST_EVENT_CODE=

# ---- Order delivery: configure AT LEAST ONE ----
# Without one of these, /api/order returns 502 and every customer
# falls through to the WhatsApp fallback.

# Formspree form id ONLY - the 8 characters, not a URL, not an email.
# Dashboard -> your form -> the id in https://formspree.io/f/XXXXXXXX
FORMSPREE_FORM_ID=

# Telegram instant order alerts (optional, recommended for COD).
# Bot token from @BotFather; chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
