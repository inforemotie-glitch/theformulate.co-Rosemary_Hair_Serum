# Copy to .env.local for `vercel dev`. Never commit real values.
# In production these are set in the Vercel dashboard:
#   Settings -> Environment Variables (tick Production, Preview, Development)
#
# Orders go straight from the browser to Formspree
# (https://formspree.io/f/xppzlgpr, hard-coded in script.js), so no
# Formspree secret is needed here. These two are only for the
# Conversions API.

META_PIXEL_ID=823926397477218
META_CAPI_TOKEN=

# Set ONLY while testing in Events Manager -> Test Events.
# Delete it before trusting production numbers: events carrying a
# test code do not count toward ad optimisation.
META_TEST_EVENT_CODE=
